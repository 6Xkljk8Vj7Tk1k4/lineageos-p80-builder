From d42a105e9ef85d5dd865dac3c076a59f04a1624d Mon Sep 17 00:00:00 2001
From: P80 builder <builder@localhost>
Date: Tue, 27 Oct 2026 19:52:00 +0100
Subject: [PATCH 10/17] Teclast P80: 720p camcorder profile for the rear camera

The vendor's /vendor/etc/media_profiles_V1_0.xml only defines 480p for
both cameras, with 12.2 kbit/s 8 kHz AAC audio, although the rear camera
outputs 1280x720 at up to 30 fps and OMX.allwinner.video.encoder.avc
handles 1280x720 at 30 fps. Ship profiles with an added 720p (4 Mbit/s)
profile for camera 0, 96 kbit/s 44.1 kHz AAC and raised encoder bitrate
caps, and let rw-system.sh bind-mount them over the vendor file on this
tablet (ro.product.vendor.device=P80_G3M2_EEA) before zygote preloads
the profiles. Tested by mounting the file by hand: Aperture then offers
HD and records 720p.
---
 lineage_arm64_bvN4.mk       |   5 +
 p80/media_profiles_V1_0.xml | 238 ++++++++++++++++++++++++++++++++++++
 rw-system.sh                |  16 +++
 3 files changed, 259 insertions(+)
 create mode 100644 p80/media_profiles_V1_0.xml

diff --git a/lineage_arm64_bvN4.mk b/lineage_arm64_bvN4.mk
index 17c514f..ddd8249 100644
--- a/lineage_arm64_bvN4.mk
+++ b/lineage_arm64_bvN4.mk
@@ -30,3 +30,8 @@ PRODUCT_DEXPREOPT_SPEED_APPS += \
     Settings \
     LineageSetupWizard \
     Jelly
+
+# Teclast P80: camcorder profiles with 720p for the rear camera, bind-mounted over the
+# vendor's by rw-system.sh.
+PRODUCT_COPY_FILES += \
+    device/phh/treble/p80/media_profiles_V1_0.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/p80/media_profiles_V1_0.xml
diff --git a/p80/media_profiles_V1_0.xml b/p80/media_profiles_V1_0.xml
new file mode 100644
index 0000000..7560885
--- /dev/null
+++ b/p80/media_profiles_V1_0.xml
@@ -0,0 +1,238 @@
+<?xml version="1.0" encoding="utf-8"?>
